# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── C++ / CUDA compiled artifacts ───────────────────────────────────────────
*.so
*.o
*.a
*.lib
*.dll
*.dylib
submodules/*/build/
submodules/*/*.egg-info/

# ── Submodule source trees (tracked as git submodules, not inline) ───────────
submodules/

# ── Model output (large, not source code) ───────────────────────────────────
output/
*.ply
*.pth
*.pt
*.ckpt
*.pkl
*.safetensors

# ── Training logs ───────────────────────────────────────────────────────────
logs/
wandb/
runs/
tensorboard*/

# ── Segmentation results (user-specific, not code) ──────────────────────────
segmentation_res/

# ── Data / datasets ─────────────────────────────────────────────────────────
data/
datasets/

# ── 3dgrut / OptiX compiled plugin ──────────────────────────────────────────
# 3dgrut/ source is tracked; ignore only compiled/cache artifacts inside it
3dgrut/**/__pycache__/
3dgrut/**/*.egg-info/
3dgrut/**/build/
3dgrut/**/*.so
3dgrut/**/*.ninja
3dgrut/**/*.ninja_log
3dgrut/.git/
optix_integration/__pycache__/
*.ninja
*.ninja_log

# ── PyTorch extensions cache ─────────────────────────────────────────────────
~/.cache/torch_extensions/

# ── DearPyGui / UI state ────────────────────────────────────────────────────
imgui.ini
*.dpg

# ── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Images / screenshots (not source) ───────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.mp4
*.avi

# Allow demo and assets directories
!demo/
!demo/**
!assets/
!assets/**

# ── PDF documents ───────────────────────────────────────────────────────────
*.pdf

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.bak

# ── Environment ─────────────────────────────────────────────────────────────
.env
.venv/
env/
venv/

# ── Conda env (keep YML spec, ignore the actual env folder) ─────────────────
conda-env/
