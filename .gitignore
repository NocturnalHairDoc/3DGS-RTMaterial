# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── C++ / CUDA compiled artifacts ───────────────────────────────────────────
*.so
*.o
*.a
*.lib
*.dll
*.dylib
submodules/*/build/
submodules/*/*.egg-info/

# ── Submodule source trees (tracked as git submodules, not inline) ───────────
submodules/

# ── Model output (large, not source code) ───────────────────────────────────
output/
output-v2/
*.ply
*.pth
*.pt
*.ckpt
*.pkl
*.safetensors

# ── Training logs ───────────────────────────────────────────────────────────
logs/
wandb/
runs/
tensorboard*/

# ── Segmentation results (user-specific, not code) ──────────────────────────
segmentation_res/
exports/
*.npz

# ── Data / datasets ─────────────────────────────────────────────────────────
data/
datasets/

# ── 3dgrut / OptiX compiled plugin ──────────────────────────────────────────
# Downloaded by setup.sh. Ignore the entire nested repository so Git cannot
# accidentally stage it as an embedded repository or gitlink.
3dgrut/
optix_integration/__pycache__/
*.ninja
*.ninja_log

# ── PyTorch extensions cache ─────────────────────────────────────────────────
.cache/
torch_extensions/

# ── DearPyGui / UI state ────────────────────────────────────────────────────
imgui.ini
*.dpg

# ── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Images / screenshots (not source) ───────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.mp4
*.avi
*.webm

# Allow demo and assets directories
!demo/
!demo/**
!assets/
!assets/**

# ── PDF documents ───────────────────────────────────────────────────────────
*.pdf

# ── Report folder: keep reproducible sources, figures and compiled PDF ───────
!report/*.tex
!report/*.bib
!report/fig_rgb.png
!report/fig_multi_mat.png
!report/3dgs-RTM.pdf

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.bak

# ── Environment ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.venv/
env/
venv/

# ── Conda env (keep YML spec, ignore the actual env folder) ─────────────────
conda-env/

# ── Test and analysis caches ────────────────────────────────────────────────
tests/
.github/workflows/tests.yml
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
tmp/

# ── Local credentials and machine-specific configuration ───────────────────
*.pem
*.key
*.p12
credentials.json
